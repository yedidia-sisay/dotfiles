{
  "description": "Archive Codex conversation transcripts and final reports under .cherry.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.cherry/hooks/archive_chat.py\"",
            "timeout": 30,
            "statusMessage": "Saving chat transcript and report"
          }
        ]
      }
    ]
  }
}
